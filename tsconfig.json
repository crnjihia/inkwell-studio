{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@inkwell/db": ["packages/db/src"],
      "@inkwell/db/*": ["packages/db/src/*"]
    }
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx"]
}
