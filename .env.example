# ==============================================================================
# INKWELL STUDIO ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Runtime & URLs
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EDGE_URL=http://localhost:8787
APP_TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES
USD_TO_KES_RATE=130.00

# AI Provider Configuration (Anthropic)
# IMPORTANT: Model ID must be set here and never hard-coded in source code.
# e.g., claude-3-5-sonnet-20241022 or claude-3-haiku-20240307
ANTHROPIC_API_KEY=sk-ant-api03-sample-key-do-not-commit
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Set AI_MOCK_MODE=true for local offline testing with zero API tokens
AI_MOCK_MODE=true

# Database Connection (PostgreSQL / TimescaleDB)
# Local Timescale container: postgresql://postgres:postgres@localhost:5432/inkwell_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inkwell_dev

# Authentication (Clerk)
# Use AUTH_MODE=dev for offline zero-credentials local development
AUTH_MODE=dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret

# Cloudflare Edge & Cache Configuration
CLOUDFLARE_ACCOUNT_ID=sample_cf_account_id
CLOUDFLARE_ZONE_ID=sample_cf_zone_id
CLOUDFLARE_API_TOKEN=sample_cf_api_token
# Edge rate limiting threshold: requests per minute per IP/User
EDGE_RATE_LIMIT_RPM=60

# Notification Adapters
# Options: mock | smtp
EMAIL_ADAPTER=mock

